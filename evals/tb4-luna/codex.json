{
  "job_name": "tb4-luna-max-codex",
  "jobs_dir": "out/terminal-bench/jobs",
  "n_attempts": 3,
  "n_concurrent_trials": 8,
  "timeout_multiplier": 1.0,
  "retry": {
    "max_retries": 3,
    "exclude_exceptions": [
      "AgentTimeoutError",
      "VerifierTimeoutError",
      "RewardFileNotFoundError",
      "RewardFileEmptyError",
      "VerifierOutputParseError",
      "AgentSafetyRefusalError"
    ]
  },
  "environment": {
    "type": "modal",
    "cpu_enforcement_policy": "auto",
    "memory_enforcement_policy": "auto"
  },
  "agents": [
    {
      "import_path": "evals.harbor_claude_codex:CodexAgent",
      "model_name": "openai/gpt-6-luna",
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      },
      "kwargs": {
        "wire_binary_path": "out/terminal-bench/tb4/harbor-wire-linux-amd64",
        "effort": "max",
        "version": "0.151.0"
      }
    }
  ],
  "datasets": [
    {
      "name": "terminal-bench/terminal-bench",
      "ref": "sha256:39d9f44b40420cde8fdcc087579c0d72a7e14fa3656d603c3f0d22fb35e27732"
    }
  ]
}
